{
  "manifest_version": 3,
  "name": "Catstella · Gemini Web Companion",
  "version": "1.5.1",
  "description": "Gemini 网页端专属桌宠挂件与星语毛玻璃主题 (Dream Skin)。支持与 Catstella 桌面套件双端联动、官方用量双周期同步与跨浏览器兼容。",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://gemini.google.com/*",
    "http://127.0.0.1/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kimino-gemini-companion@antigravity",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Catstella · 设置 / Settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://gemini.google.com/*"
      ],
      "js": [
        "content/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://gemini.google.com/*"
      ],
      "js": [
        "content/shim.js",
        "content/inject-bridge.js",
        "content/tracker.js",
        "content/wallpaper.js",
        "content/wallpaper-packs.js",
        "content/fade.js",
        "content/skin.js",
        "content/ambient.js",
        "content/pet-behavior.js",
        "content/usage-viewer.js",
        "online/panel.js",
        "online/content-hub.js",
        "online/store.js",
        "content/widget.js"
      ],
      "css": [
        "content/skin.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/*/*",
        "assets/*/*/*",
        "assets/characters/gemini-star-v1/*",
        "assets/characters/lin-cat/*",
        "assets/wallpapers/*",
        "assets/audio/*",
        "assets/dialogue/*",
        "assets/icons/*",
        "assets/manifest.json",
        "content/*",
        "online/content-hub.css"
      ],
      "matches": [
        "*://gemini.google.com/*"
      ]
    }
  ]
}
