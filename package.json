{
  "name": "catstella",
  "version": "0.6.0",
  "private": true,
  "byokDevelopment": false,
  "description": "Catstella: All-in-one Gemini Catgirl Companion Suite (Desktop Widget, IDE Dream Skin, Web Extension)",
  "scripts": {
    "start:widget": "node tools/launch.cjs",
    "restart:widget": "node tools/restart.cjs",
    "test": "node --test Antigravity-Cat-Widget/test/runtime.test.cjs Antigravity-Cat-Widget/test/startup-render.test.cjs Antigravity-Dream-Skin/test/runtime.test.cjs tools/source-hashes.test.cjs Antigravity-Cat-Widget/test/personality.test.cjs Antigravity-Cat-Widget/test/quota-cache.test.cjs shared/companion-bridge.test.cjs tools/web-companion-path.test.cjs Antigravity-Cat-Widget/test/companion-visibility.test.cjs shared/online.test.cjs",
    "verify:runtime": "node tools/verify-runtime.cjs",
    "verify:cold-start": "node tools/verify-cold-start.cjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-native.ps1",
    "build:installers": "node tools/build-installers.cjs",
    "verify:installers": "node tools/verify-installers.cjs",
    "setup:inno": "node tools/ensure-inno.cjs",
    "package:mac": "electron-builder --mac dmg zip",
    "package:linux": "electron-builder --linux AppImage tar.gz"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5"
  },
  "license": "MIT",
  "author": "lynnfei & Monokumakuki",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynnfei/Catstella.git"
  },
  "main": "Antigravity-Cat-Widget/src/main/index.cjs",
  "build": {
    "appId": "com.lynnfei.catstella",
    "productName": "Catstella",
    "asar": false,
    "afterPack": "./tools/release-payload.cjs",
    "directories": {
      "output": "dist/installers"
    },
    "files": [
      "Antigravity-Cat-Widget/**/*",
      "Antigravity-Dream-Skin/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md",
      "ASSETS.md",
      "!**/*.test.cjs",
      "!**/*.cs",
      "!Antigravity-Cat-Widget/assets/characters/**/*",
      "!tools/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "darkModeSupport": true,
      "icon": "Antigravity-Cat-Widget/assets/character-packs/gemini-star-v1/frames/idle.png",
      "artifactName": "Catstella-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "Antigravity-Cat-Widget/assets/character-packs/gemini-star-v1/frames/idle.png",
      "artifactName": "Catstella-${version}-linux-${arch}.${ext}"
    }
  }
}
