{
  "name": "catstella",
  "version": "0.3.0",
  "private": true,
  "description": "Catstella: All-in-one Gemini Catgirl Companion Suite (Desktop Widget, IDE Dream Skin, Web Extension)",
  "scripts": {
    "start:widget": "node tools/launch.cjs widget",
    "start:skin": "node tools/launch.cjs skin",
    "test": "node --test Antigravity-Cat-Widget/test/runtime.test.cjs Antigravity-Dream-Skin/test/runtime.test.cjs tools/source-hashes.test.cjs Antigravity-Cat-Widget/test/personality.test.cjs Antigravity-Cat-Widget/test/quota-cache.test.cjs",
    "test:web": "node --test Gemini-Web-Companion/test/turn-watcher.test.cjs Gemini-Web-Companion/test/runtime.test.cjs",
    "test:web:browser": "node Gemini-Web-Companion/test/skin-browser.cjs && node Gemini-Web-Companion/test/fade-browser.cjs && node Gemini-Web-Companion/test/wallpaper-browser.cjs && node Gemini-Web-Companion/test/interaction-browser.cjs && node Gemini-Web-Companion/test/online-browser.cjs",
    "verify:runtime": "node tools/verify-runtime.cjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-native.ps1",
    "build:installers": "node tools/build-installers.cjs",
    "verify:installers": "node tools/verify-installers.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5"
  },
  "license": "MIT",
  "author": "lynnfei & Monokumakuki",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynnfei/Catstella.git"
  }
}
